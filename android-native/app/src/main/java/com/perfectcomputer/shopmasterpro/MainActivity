  interface SaveForm{void save(String[] v);} void formDialog(String title,String[] labels,SaveForm save){LinearLayout box=column();ScrollView sv=new ScrollView(this);sv.addView(box);EditText[] es=new EditText[labels.length];for(int i=0;i<labels.length;i++){TextView l=text(labels[i],12,INK,true);l.setPadding(0,dp(6),0,0);box.addView(l);es[i]=input(labels[i]);box.addView(es[i]);}new AlertDialog.Builder(this).setTitle(title).setView(sv).setNegativeButton("Cancel",null).setPositiveButton("Save",(d,w)->{String[] vals=new String[es.length];for(int i=0;i<es.length;i++)vals[i]=es[i].getText().toString().trim();save.save(vals);}).show();}
  void invoiceDialog(String kind){Cursor p=db.get("SELECT id,name,price,stock FROM products ORDER BY name");ArrayList<Integer> ids=new ArrayList<>();ArrayList<String> names=new ArrayList<>();while(p.moveToNext()){ids.add(p.getInt(0));names.add(p.getString(1)+"  (Stock "+p.getDouble(3)+")");}p.close();if(ids.isEmpty()){new AlertDialog.Builder(this).setMessage("Please add a product first.").setPositiveButton("Add Product",(d,w)->productDialog()).setNegativeButton("Cancel",null).show();return;}
    Cursor cu=db.get("SELECT id,name FROM customers ORDER BY name");ArrayList<Integer> cids=new ArrayList<>();ArrayList<String> cnames=new ArrayList<>();cnames.add("Walk-in Customer");cids.add(0);while(cu.moveToNext()){cids.add(cu.getInt(0));cnames.add(cu.getString(1));}cu.close();LinearLayout box=column();pad(box,8);Spinner ps=new Spinner(this);ps.setAdapter(new ArrayAdapter<>(this,android.R.layout.simple_spinner_dropdown_item,names));Spinner cs=new Spinner(this);cs.setAdapter(new ArrayAdapter<>(this,android.R.layout.simple_spinner_dropdown_item,cnames));EditText qty=input("Quantity");qty.setText("1");EditText discount=input("Discount amount (₹)");discount.setText("0");EditText tax=input("Manual GST % (0 = no GST)");tax.setText("0");EditText date=input("Date YYYY-MM-DD");date.setText(today());EditText notes=input("Notes");Spinner template=new Spinner(this);template.setAdapter(new ArrayAdapter<>(this,android.R.layout.simple_spinner_dropdown_item,new String[]{"Classic","Modern","Minimal","Professional","Premium"}));box.addView(text("Select Product",12,INK,true));box.addView(ps);box.addView(text("Customer",12,INK,true));box.addView(cs);box.addView(qty);box.addView(discount);box.addView(tax);box.addView(date);box.addView(notes);box.addView(text("PDF Template",12,INK,true));box.addView(template);
    new AlertDialog.Builder(this).setTitle("Create "+kind).setView(box).setNegativeButton("Cancel",null).setPositiveButton("Save",(d,w)->{int ix=ps.getSelectedItemPosition(),productId=ids.get(ix),customerId=cids.get(cs.getSelectedItemPosition());double q=num(qty.getText().toString()),gst=num(tax.getText().toString()),disc=num(discount.getText().toString());if(q<=0){toast("Quantity must be greater than zero");return;}Cursor pr=db.get("SELECT name,price,stock FROM products WHERE id="+productId);if(!pr.moveToFirst()){pr.close();return;}String pn=pr.getString(0);double rate=pr.getDouble(1),stock=pr.getDouble(2);pr.close();if(kind.equals("Invoice")&&q>stock){toast("Insufficient stock");return;}String customer="Walk-in Customer";if(customerId>0){Cursor cc=db.get("SELECT name FROM customers WHERE id="+customerId);if(cc.moveToFirst())customer=cc.getString(0);cc.close();}double sub=q*rate,taxAmt=sub*gst/100,total=Math.max(0,sub+taxAmt-disc);String no=(kind.equals("Invoice")?"INV-":"QUO-")+String.format(Locale.US,"%04d",db.countWhere("invoices","kind='"+kind+"'")+1);db.insert("INSERT INTO invoices(number,kind,customer,product,qty,rate,subtotal,gst_rate,tax,discount,total,date,notes,template) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)",no,kind,customer,pn,q,rate,sub,gst,taxAmt,disc,total,empty(date.getText().toString(),today()),notes.getText().toString(),template.getSelectedItem().toString());if(kind.equals("Invoice"))db.exec("UPDATE products SET stock=stock-"+q+" WHERE id="+productId);showPage("Sales");toast(kind+" saved");}).show();}
  void documentOptions(int id){new AlertDialog.Builder(this).setTitle("Invoice PDF Options").setItems(new String[]{"Share PDF","Print Invoice","Save PDF"},(d,w)->{if(w==0)sharePdf(id);else if(w==1)printPdf(id);else savePdfToDownloads(id);}).show();}
  String[] invoiceRow(int id){Cursor c=db.get("SELECT number,kind,customer,product,qty,rate,subtotal,gst_rate,tax,discount,total,date,notes,template FROM invoices WHERE id="+id);if(!c.moveToFirst()){c.close();return null;}String[] v=new String[14];for(int i=0;i<14;i++)v[i]=c.getString(i);c.close();return v;}
  void printPdf(int id){String[] v=invoiceRow(id);if(v==null)return;File f=makePdf(v);if(f==null)return;PrintManager pm=(PrintManager)getSystemService(PRINT_SERVICE);pm.print(v[0],new PdfPrintAdapter(f),new PrintAttributes.Builder().setMediaSize(PrintAttributes.MediaSize.ISO_A4).setResolution(new PrintAttributes.Resolution("pdf","pdf",300,300)).setMinMargins(PrintAttributes.Margins.NO_MARGINS).build());}
  void savePdfToDownloads(int id){String[] v=invoiceRow(id);if(v==null)return;File f=makePdf(v);if(f==null)return;Intent i=new Intent(Intent.ACTION_CREATE_DOCUMENT);i.setType("application/pdf");i.putExtra(Intent.EXTRA_TITLE,v[0]+".pdf");startActivityForResult(i,78);pendingPdf=f;}
  File pendingPdf;
  @Override protected void onActivityResult(int req,int result,Intent data){super.onActivityResult(req,result,data);if(result!=RESULT_OK||data==null)return;try{if(req==77){Uri u=data.getData();getContentResolver().takePersistableUriPermission(u,Intent.FLAG_GRANT_READ_URI_PERMISSION);logoUri=u.toString();db.setting("logoUri",logoUri);toast("Shop logo saved");showPage("Profile");}else if(req==78&&pendingPdf!=null){InputStream in=new FileInputStream(pendingPdf);OutputStream out=getContentResolver().openOutputStream(data.getData());byte[] buf=new byte[8192];int n;while((n=in.read(buf))>0)out.write(buf,0,n);in.close();out.close();toast("PDF saved successfully");}}catch(Exception e){toast("Unable to save: "+e.getMessage());}}
  class PdfPrintAdapter extends PrintDocumentAdapter{File file;PdfPrintAdapter(File f){file=f;}public void onLayout(PrintAttributes oldA,PrintAttributes newA,CancellationSignal cs,LayoutResultCallback cb,Bundle extras){if(cs.isCanceled()){cb.onLayoutCancelled();return;}cb.onLayoutFinished(new PrintDocumentInfo.Builder(file.getName()).setContentType(PrintDocumentInfo.CONTENT_TYPE_DOCUMENT).setPageCount(1).build(),true);}public void onWrite(PageRange[] pages,ParcelFileDescriptor dest,CancellationSignal cs,WriteResultCallback cb){try{InputStream in=new FileInputStream(file);OutputStream out=new FileOutputStream(dest.getFileDescriptor());byte[] b=new byte[8192];int n;while((n=in.read(b))>0){if(cs.isCanceled()){cb.onWriteCancelled();in.close();return;}out.write(b,0,n);}in.close();out.flush();cb.onWriteFinished(new PageRange[]{PageRange.ALL_PAGES});}catch(Exception e){cb.onWriteFailed(e.getMessage());}}}
  void sharePdf(int id){Cursor c=db.get("SELECT number,kind,customer,product,qty,rate,subtotal,gst_rate,tax,discount,total,date,notes,template FROM invoices WHERE id="+id);if(!c.moveToFirst()){c.close();return;}String[] v=new String[14];for(int i=0;i<14;i++)v[i]=c.getString(i);c.close();File f=makePdf(v);if(f==null)return;Uri u=FileProvider.getUriForFile(this,getPackageName()+".provider",f);Intent send=new Intent(Intent.ACTION_SEND);send.setType("application/pdf");send.putExtra(Intent.EXTRA_STREAM,u);send.putExtra(Intent.EXTRA_SUBJECT,v[0]);send.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);startActivity(Intent.createChooser(send,"Share PDF"));}
  File makePdf(String[] v){try{PdfDocument doc=new PdfDocument();PdfDocument.PageInfo pi=new PdfDocument.PageInfo.Builder(595,842,1).create();PdfDocument.Page page=doc.startPage(pi);Canvas c=page.getCanvas();Paint p=new Paint(3);p.setColor(NAVY);c.drawRect(0,0,595,115,p);p.setColor(Color.WHITE);p.setTextSize(25);p.setTypeface(Typeface.create("sans-serif",Typeface.BOLD));c.drawText(shopName,35,48,p);p.setTextSize(15);c.drawText(v[1].toUpperCase(Locale.ROOT),35,82,p);if(!logoUri.isEmpty()){try{Bitmap bm=BitmapFactory.decodeStream(getContentResolver().openInputStream(Uri.parse(logoUri)));if(bm!=null){Rect dst=new Rect(490,18,565,92);c.drawBitmap(bm,null,dst,p);bm.recycle();}}catch(Exception ignored){}}p.setColor(INK);p.setTextSize(12);p.setTypeface(Typeface.DEFAULT);int y=155;c.drawText("Invoice No: "+v[0],35,y,p);c.drawText("Date: "+v[11],390,y,p);y+=28;c.drawText("Bill To: "+v[2],35,y,p);y+=38;p.setTypeface(Typeface.BOLD);c.drawText("ITEM",35,y,p);c.drawText("QTY",310,y,p);c.drawText("RATE",390,y,p);c.drawText("AMOUNT",485,y,p);y+=12;p.setStrokeWidth(1);c.drawLine(35,y,560,y,p);y+=25;p.setTypeface(Typeface.DEFAULT);c.drawText(v[3],35,y,p);c.drawText(v[4],310,y,p);c.drawText(money(Double.parseDouble(v[5])),390,y,p);c.drawText(money(Double.parseDouble(v[6])),485,y,p);y+=45;String[] labels={"Subtotal","GST ("+v[7]+"%)","Discount","Grand Total"};String[] vals={v[6],v[8],v[9],v[10]};for(int i=0;i<4;i++){p.setTypeface(i==3?Typeface.DEFAULT_BOLD:Typeface.DEFAULT);c.drawText(labels[i],380,y,p);c.drawText(money(Double.parseDouble(vals[i])),485,y,p);y+=25;}y+=45;p.setTypeface(Typeface.DEFAULT);c.drawText("Shop: "+shopName+"  |  "+shopPhone,35,y,p);y+=20;c.drawText(shopAddress,35,y,p);y+=20;c.drawText("GSTIN: "+shopGstin,35,y,p);y+=40;c.drawText("Thank you for your business.",35,y,p);doc.finishPage(page);File dir=new File(getCacheDir(),"invoices");dir.mkdirs();File f=new File(dir,v[0]+".pdf");FileOutputStream out=new FileOutputStream(f);doc.writeTo(out);out.close();doc.close();return f;}catch(Exception e){toast("PDF error: "+e.getMessage());return null;}}
  void toast(String s){Toast.makeText(this,s,Toast.LENGTH_LONG).show();}String money(double n){return "₹"+String.format(Locale.getDefault(),"%,.2f",n);}double num(String s){try{return Double.parseDouble(s);}catch(Exception e){return 0;}}String empty(String s,String d){return s==null||s.trim().isEmpty()?d:s;}String today(){return new SimpleDateFormat("yyyy-MM-dd",Locale.US).format(new Date());}
  static class DB extends SQLiteOpenHelper{DB(Context c){super(c,"shopmaster.db",null,1);}public void onCreate(SQLiteDatabase d){d.execSQL("CREATE TABLE products(id INTEGER PRIMARY KEY AUTOINCREMENT,name TEXT,sku TEXT,category TEXT,price REAL,purchase REAL,stock REAL,unit TEXT,gst REAL)");d.execSQL("CREATE TABLE customers(id INTEGER PRIMARY KEY AUTOINCREMENT,name TEXT,phone TEXT,email TEXT,address TEXT,gstin TEXT,city TEXT,state TEXT)");d.execSQL("CREATE TABLE invoices(id INTEGER PRIMARY KEY AUTOINCREMENT,number TEXT,kind TEXT,customer TEXT,product TEXT,qty REAL,rate REAL,subtotal REAL,gst_rate REAL,tax REAL,discount REAL,total REAL,date TEXT,notes TEXT,template TEXT)");d.execSQL("CREATE TABLE expenses(id INTEGER PRIMARY KEY AUTOINCREMENT,title TEXT,category TEXT,amount REAL,date TEXT,notes TEXT)");d.execSQL("CREATE TABLE purchases(id INTEGER PRIMARY KEY AUTOINCREMENT,supplier TEXT,total REAL,date TEXT,notes TEXT)");d.execSQL("CREATE TABLE settings(k TEXT PRIMARY KEY,v TEXT)");}public void onUpgrade(SQLiteDatabase d,int o,int n){}Cursor get(String q){return getReadableDatabase().rawQuery(q,null);}void exec(String q){getWritableDatabase().execSQL(q);}long count(String t){Cursor c=get("SELECT COUNT(*) FROM "+t);c.moveToFirst();long n=c.getLong(0);c.close();return n;}long countWhere(String t,String w){Cursor c=get("SELECT COUNT(*) FROM "+t+" WHERE "+w);c.moveToFirst();long n=c.getLong(0);c.close();return n;}double sum(String t,String col,String where){Cursor c=get("SELECT COALESCE(SUM("+col+"),0) FROM "+t+(where==null?"":" WHERE "+where));c.moveToFirst();double n=c.getDouble(0);c.close();return n;}void insert(String sql,Object...v){SQLiteStatement s=getWritableDatabase().compileStatement(sql);for(int i=0;i<v.length;i++){Object x=v[i];if(x instanceof Number)s.bindDouble(i+1,((Number)x).doubleValue());else s.bindString(i+1,String.valueOf(x));}s.executeInsert();s.close();}void setting(String k,String v){insert("INSERT OR REPLACE INTO settings(k,v) VALUES(?,?)",k,v);}String setting(String k,String def){Cursor c=get("SELECT v FROM settings WHERE k='"+k.replace("'","''")+"'");String v=def;if(c.moveToFirst())v=c.getString(0);c.close();return v;}}
