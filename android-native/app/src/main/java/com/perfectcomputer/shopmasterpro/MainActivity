  void dashboard(){heading("Dashboard","Your business at a glance");card("TOTAL SALES",money(db.sum("invoices","total","kind='Invoice'")),"All saved invoices");card("PRODUCTS IN STOCK",db.count("products"),"Products in your inventory");card("CUSTOMERS",db.count("customers"),"Saved customer accounts");card("OTHER EXPENSES",money(db.sum("expenses","amount",null)),"Recorded expenses");heading("Quick Access","Create and manage daily business entries");action("＋ Create Invoice",()->invoiceDialog("Invoice"));action("＋ Create Quotation",()->invoiceDialog("Quotation"));action("＋ Add Product",()->productDialog());action("＋ Add Customer",()->customerDialog());action("＋ Add Expense",()->expenseDialog());action("Shop Profile & Logo",()->showPage("Profile"));}
