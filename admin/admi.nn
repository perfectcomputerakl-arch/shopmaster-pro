<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>ShopMaster Pro - Admin</title>
<style>
  :root { --bg:#f3f5f9; --card:#fff; --ink:#18202b; --muted:#667085; --line:#e2e6ee; --brand:#1d5cff; --ok:#059669; --bad:#b91c1c; }
  * { box-sizing: border-box; }
  body { margin:0; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; background:var(--bg); color:var(--ink); }
  header { background:var(--brand); color:#fff; padding:14px 18px; }
  header h1 { margin:0; font-size:18px; } header small { opacity:.85; }
  main { max-width:900px; margin:0 auto; padding:14px; }
  nav { display:flex; gap:6px; margin-bottom:12px; flex-wrap:wrap; }
  nav button { flex:1; min-width:90px; padding:10px; border:1px solid var(--line); background:#fff; border-radius:10px; font-weight:600; cursor:pointer; }
  nav button.on { background:var(--brand); color:#fff; border-color:var(--brand); }
  .card { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:14px; margin-bottom:12px; }
  h3 { margin:0 0 10px; font-size:16px; }
  label { display:block; font-size:12px; color:var(--muted); margin-bottom:10px; }
  input, select, textarea { width:100%; padding:10px; margin-top:4px; border:1px solid var(--line); border-radius:8px; font-size:14px; font-family:inherit; }
  textarea { font-family: ui-monospace, Menlo, Consolas, monospace; font-size:12px; }
  .row { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  button.btn { padding:10px 14px; border:0; border-radius:8px; background:var(--brand); color:#fff; font-weight:600; cursor:pointer; font-size:14px; }
  button.btn.alt { background:#fff; color:var(--brand); border:1px solid var(--brand); }
  button.btn.red { background:var(--bad); }
  button.btn.sm { padding:6px 9px; font-size:12px; }
  .stats { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:12px; }
  .stat { background:#fff; border:1px solid var(--line); border-radius:12px; padding:10px; text-align:center; }
  .stat b { display:block; font-size:18px; } .stat span { font-size:11px; color:var(--muted); }
  .out { word-break:break-all; background:#f6f8fc; border:1px dashed var(--brand); border-radius:10px; padding:10px; font-family:ui-monospace,Menlo,monospace; font-size:12px; }
  .actions { display:flex; gap:8px; flex-wrap:wrap; margin-top:10px; }
  table { width:100%; border-collapse:collapse; font-size:13px; }
  th, td { text-align:left; padding:8px 6px; border-bottom:1px solid var(--line); vertical-align:top; }
  th { font-size:11px; color:var(--muted); text-transform:uppercase; }
  .tablewrap { overflow-x:auto; }
  .msg { padding:10px; border-radius:8px; font-size:13px; margin-top:10px; }
  .msg.ok { background:#e8f8f1; color:#066c4b; } .msg.err { background:#fdeaea; color:var(--bad); }
  .warn { background:#fff7e0; color:#7a5200; padding:10px; border-radius:8px; font-size:13px; margin-bottom:10px; }
  .hide { display:none; }
  .muted { color:var(--muted); font-size:12px; }
</style>
</head>
<body>
<header>
  <h1>ShopMaster Pro - Admin Panel</h1>
  <small>Subscription codes banayein, bhejein aur track karein</small>
</header>
<main>
  <nav id="tabs">
    <button data-t="gen" class="on">Generate</button>
    <button data-t="log">Codes</button>
    <button data-t="ver">Verify</button>
    <button data-t="keys">Keys</button>
  </nav>

  <!-- GENERATE -->
  <section id="t-gen">
    <div id="nokey" class="warn hide">Pehle <b>Keys</b> tab mein "Generate keys" dabayein (sirf ek baar).</div>
    <div class="card">
      <h3>Naya activation code</h3>
      <div class="row">
        <label>Customer / Shop name<input id="g-name" placeholder="e.g. Sharma Traders" /></label>
        <label>WhatsApp number<input id="g-phone" inputmode="tel" placeholder="9876543210" /></label>
      </div>
      <div class="row">
        <label>Plan
          <select id="g-plan"></select>
        </label>
        <label>Amount received (Rs.)<input id="g-amt" type="number" min="0" /></label>
      </div>
      <label id="g-custom-wrap" class="hide">Custom days<input id="g-custom" type="number" min="1" value="30" /></label>
      <label>Note (optional)<input id="g-note" placeholder="UPI / Cash / reference" /></label>
      <button class="btn" id="g-btn">Code banayein</button>
      <div id="g-result" class="hide">
        <div class="msg ok" style="margin-top:12px">Code taiyaar hai. Customer ko bhej dein.</div>
        <div class="out" id="g-code"></div>
        <div class="actions">
          <button class="btn sm" id="g-copy">Copy code</button>
          <button class="btn sm alt" id="g-wa">WhatsApp par bhejein</button>
        </div>
      </div>
    </div>
    <div class="card">
      <h3>Plan prices (default)</h3>
      <p class="muted" style="margin-top:0">Yahan price badlein, agli baar plan chunne par yahi amount aayega. Ye sirf aapke hisaab ke liye hai.</p>
      <div id="price-list"></div>
    </div>
  </section>

  <!-- LOG -->
  <section id="t-log" class="hide">
    <div class="stats">
      <div class="stat"><b id="s-count">0</b><span>Total codes</span></div>
      <div class="stat"><b id="s-rev">Rs. 0</b><span>Total income</span></div>
      <div class="stat"><b id="s-month">Rs. 0</b><span>Is mahine</span></div>
    </div>
    <div class="card">
      <input id="l-search" placeholder="Search name, phone, code id..." />
      <div class="actions"><button class="btn sm alt" id="l-csv">Export CSV</button></div>
      <div class="tablewrap" style="margin-top:10px">
        <table><thead><tr><th>Date</th><th>Customer</th><th>Plan</th><th>Rs.</th><th></th></tr></thead><tbody id="l-body"></tbody></table>
      </div>
      <p id="l-empty" class="muted hide">Abhi koi code nahi bana.</p>
    </div>
  </section>

  <!-- VERIFY -->
  <section id="t-ver" class="hide">
    <div class="card">
      <h3>Code check karein</h3>
      <label>Code paste karein<textarea id="v-code" rows="4"></textarea></label>
      <button class="btn" id="v-btn">Check</button>
      <div id="v-out"></div>
    </div>
  </section>

  <!-- KEYS -->
  <section id="t-keys" class="hide">
    <div class="card">
      <h3>Signing keys</h3>
      <div class="warn"><b>Zaroori:</b> private key sirf is browser mein rehti hai. Keys ka <b>Backup</b> zaroor download karke safe jagah rakhein. Key kho gayi to purane codes verify nahi honge aur naya key lagakar app dobara build karna padega. Is page ko sirf apne device par kholein.</div>
      <div id="k-status" class="msg"></div>
      <div class="actions">
        <button class="btn" id="k-gen">Generate keys</button>
        <button class="btn alt" id="k-export">Backup download</button>
        <button class="btn alt" id="k-import-btn">Backup restore</button>
        <input type="file" id="k-import" accept="application/json" class="hide" />
      </div>
    </div>
    <div class="card" id="k-pub-card">
      <h3>App ke liye public key</h3>
      <p class="muted" style="margin-top:0">Neeche ka poora text <code>src/proKey.js</code> mein paste karein (purani file replace karein), phir GitHub par push karke naya APK banayein. Ye sirf ek baar karna hai.</p>
      <textarea id="k-pub" rows="7" readonly></textarea>
      <div class="actions"><button class="btn sm" id="k-copy">Copy</button><button class="btn sm alt" id="k-dl">proKey.js download</button></div>
    </div>
  </section>
</main>

<script>
// ==CRYPTO==
const enc = new TextEncoder();
const toB64u = bytes => btoa(String.fromCharCode(...new Uint8Array(bytes))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
const fromB64u = s => Uint8Array.from(atob(s.replace(/-/g, '+').replace(/_/g, '/')), c => c.charCodeAt(0));
const ALPHA = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
const randomId = () => Array.from(crypto.getRandomValues(new Uint8Array(8)), b => ALPHA[b % ALPHA.length]).join('');
const ALG = { name: 'ECDSA', namedCurve: 'P-256' };
async function genKeys() {
  const kp = await crypto.subtle.generateKey(ALG, true, ['sign', 'verify']);
  const priv = await crypto.subtle.exportKey('jwk', kp.privateKey);
  const pub = await crypto.subtle.exportKey('jwk', kp.publicKey);
  return { priv, pub: { kty: pub.kty, crv: pub.crv, x: pub.x, y: pub.y } };
}
async function makeCode(priv, days) {
  const id = randomId();
  const payload = toB64u(enc.encode(JSON.stringify({ i: id, d: days, t: Math.floor(Date.now() / 1000) })));
  const key = await crypto.subtle.importKey('jwk', priv, ALG, false, ['sign']);
  const sig = await crypto.subtle.sign({ name: 'ECDSA', hash: 'SHA-256' }, key, enc.encode(payload));
  return { id, code: 'SMP-' + payload + '.' + toB64u(sig) };
}
async function checkCode(pub, text) {
  text = String(text || '').replace(/\s+/g, '');
  if (!text.startsWith('SMP-')) return { ok: false };
  try {
    const [payload, sig] = text.slice(4).split('.');
    const key = await crypto.subtle.importKey('jwk', pub, ALG, false, ['verify']);
    const ok = await crypto.subtle.verify({ name: 'ECDSA', hash: 'SHA-256' }, key, fromB64u(sig), enc.encode(payload));
    if (!ok) return { ok: false };
    return { ok: true, data: JSON.parse(new TextDecoder().decode(fromB64u(payload))) };
  } catch { return { ok: false }; }
}
// ==/CRYPTO==

const $ = id => document.getElementById(id);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const KEYS = 'smp-admin-keys', LOG = 'smp-admin-log', PRICES = 'smp-admin-prices';
const rd = (k, d) => { try { return JSON.parse(localStorage.getItem(k)) ?? d; } catch { return d; } };
const wr = (k, v) => localStorage.setItem(k, JSON.stringify(v));

const PLANS = [
  { key: 'm1', label: '1 Month (30 days)', days: 30, price: 199 },
  { key: 'm3', label: '3 Months (90 days)', days: 90, price: 499 },
  { key: 'y1', label: '1 Year (365 days)', days: 365, price: 1499 },
  { key: 'life', label: 'Lifetime', days: 0, price: 3999 },
  { key: 'custom', label: 'Custom days', days: -1, price: 0 }
];
const prices = () => ({ ...Object.fromEntries(PLANS.map(p => [p.key, p.price])), ...rd(PRICES, {}) });
const inr = n => 'Rs. ' + Number(n || 0).toLocaleString('en-IN');

// tabs
document.querySelectorAll('#tabs button').forEach(b => b.onclick = () => {
  document.querySelectorAll('#tabs button').forEach(x => x.classList.toggle('on', x === b));
  ['gen', 'log', 'ver', 'keys'].forEach(t => $('t-' + t).classList.toggle('hide', t !== b.dataset.t));
  if (b.dataset.t === 'log') renderLog();
  if (b.dataset.t === 'keys') renderKeys();
  if (b.dataset.t === 'gen') refreshGen();
});

// generate
$('g-plan').innerHTML = PLANS.map(p => `<option value="${p.key}">${p.label}</option>`).join('');
const planOf = () => PLANS.find(p => p.key === $('g-plan').value);
function refreshGen() {
  $('nokey').classList.toggle('hide', !!rd(KEYS, null));
  $('g-custom-wrap').classList.toggle('hide', planOf().key !== 'custom');
  $('g-amt').value = prices()[planOf().key] || '';
  renderPrices();
}
$('g-plan').onchange = refreshGen;
function renderPrices() {
  const pr = prices();
  $('price-list').innerHTML = PLANS.filter(p => p.key !== 'custom').map(p =>
    `<label>${p.label}<input type="number" min="0" data-pk="${p.key}" value="${pr[p.key]}" /></label>`).join('');
  document.querySelectorAll('[data-pk]').forEach(i => i.onchange = () => { const o = rd(PRICES, {}); o[i.dataset.pk] = Number(i.value) || 0; wr(PRICES, o); if (planOf().key === i.dataset.pk) $('g-amt').value = o[i.dataset.pk]; });
}
let last = null;
$('g-btn').onclick = async () => {
  const keys = rd(KEYS, null);
  if (!keys) { alert('Pehle Keys tab mein keys generate karein'); return; }
  const plan = planOf();
  const days = plan.key === 'custom' ? Math.max(1, Math.floor(Number($('g-custom').value) || 0)) : plan.days;
  const name = $('g-name').value.trim();
  if (!name) { alert('Customer ka naam likhein'); $('g-name').focus(); return; }
  const { id, code } = await makeCode(keys.priv, days);
  const entry = { id, code, name, phone: $('g-phone').value.trim(), plan: plan.key === 'custom' ? `${days} days` : plan.label, days, amount: Number($('g-amt').value) || 0, note: $('g-note').value.trim(), at: Date.now() };
  const log = rd(LOG, []); log.unshift(entry); wr(LOG, log);
  last = entry;
  $('g-code').textContent = code;
  $('g-result').classList.remove('hide');
};
const waLink = e => {
  let ph = String(e.phone || '').replace(/\D/g, ''); if (ph.length === 10) ph = '91' + ph;
  const dur = e.days > 0 ? `${e.days} din` : 'Lifetime';
  const text = `Namaste ${e.name},\nShopMaster Pro (${dur}) ka activation code:\n\n${e.code}\n\nApp mein: More > Subscription Plans > "Have an activation code?" mein paste karke Activate dabayein.`;
  return `https://wa.me/${ph}?text=${encodeURIComponent(text)}`;
};
const copy = async t => { try { await navigator.clipboard.writeText(t); } catch { const a = document.createElement('textarea'); a.value = t; document.body.appendChild(a); a.select(); document.execCommand('copy'); a.remove(); } };
$('g-copy').onclick = async () => { await copy(last.code); $('g-copy').textContent = 'Copied'; setTimeout(() => $('g-copy').textContent = 'Copy code', 1500); };
$('g-wa').onclick = () => window.open(waLink(last), '_blank');

// log
function renderLog() {
  const log = rd(LOG, []), q = $('l-search').value.trim().toLowerCase();
  const rows = log.filter(e => !q || `${e.name} ${e.phone} ${e.id} ${e.note}`.toLowerCase().includes(q));
  const mon = new Date().toISOString().slice(0, 7);
  $('s-count').textContent = log.length;
  $('s-rev').textContent = inr(log.reduce((s, e) => s + e.amount, 0));
  $('s-month').textContent = inr(log.filter(e => new Date(e.at).toISOString().slice(0, 7) === mon).reduce((s, e) => s + e.amount, 0));
  $('l-empty').classList.toggle('hide', rows.length > 0);
  $('l-body').innerHTML = rows.map(e => `<tr>
    <td>${new Date(e.at).toLocaleDateString('en-IN')}</td>
    <td><b>${esc(e.name)}</b><br><span class="muted">${esc(e.phone)} ${esc(e.note)}</span><br><span class="muted">ID: ${esc(e.id)}</span></td>
    <td>${esc(e.plan)}</td><td>${e.amount.toLocaleString('en-IN')}</td>
    <td><button class="btn sm" data-copy="${esc(e.id)}">Copy</button> <button class="btn sm alt" data-wa="${esc(e.id)}">WA</button> <button class="btn sm red" data-del="${esc(e.id)}">X</button></td></tr>`).join('');
  const find = id => rd(LOG, []).find(e => e.id === id);
  document.querySelectorAll('[data-copy]').forEach(b => b.onclick = async () => { await copy(find(b.dataset.copy).code); b.textContent = 'Done'; setTimeout(() => b.textContent = 'Copy', 1200); });
  document.querySelectorAll('[data-wa]').forEach(b => b.onclick = () => window.open(waLink(find(b.dataset.wa)), '_blank'));
  document.querySelectorAll('[data-del]').forEach(b => b.onclick = () => { if (confirm('Ye entry list se hatayein? (Code phir bhi chalega, sirf record hatega)')) { wr(LOG, rd(LOG, []).filter(e => e.id !== b.dataset.del)); renderLog(); } });
}
$('l-search').oninput = renderLog;
$('l-csv').onclick = () => {
  const q = v => '"' + String(v ?? '').replace(/"/g, '""') + '"';
  const csv = ['Date,Customer,Phone,Plan,Days,Amount,Note,CodeID'].concat(rd(LOG, []).map(e => [new Date(e.at).toISOString().slice(0, 10), e.name, e.phone, e.plan, e.days, e.amount, e.note, e.id].map(q).join(','))).join('\n');
  dl('shopmaster-codes.csv', csv, 'text/csv');
};
function dl(name, text, type) { const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([text], { type })); a.download = name; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 2000); }

// verify
$('v-btn').onclick = async () => {
  const keys = rd(KEYS, null), out = $('v-out');
  if (!keys) { out.innerHTML = '<div class="msg err">Pehle keys generate karein.</div>'; return; }
  const r = await checkCode(keys.pub, $('v-code').value);
  if (!r.ok) { out.innerHTML = '<div class="msg err">Code galat ya nakli hai.</div>'; return; }
  const e = rd(LOG, []).find(x => x.id === r.data.i);
  out.innerHTML = `<div class="msg ok">Code sahi hai.<br>ID: ${esc(r.data.i)}<br>Plan: ${r.data.d > 0 ? r.data.d + ' din' : 'Lifetime'}<br>Banaya: ${new Date(r.data.t * 1000).toLocaleString('en-IN')}${e ? `<br>Customer: ${esc(e.name)} ${esc(e.phone)}` : ''}</div>`;
};

// keys
const proKeyFile = pub => `// Public key for verifying activation codes made in admin/admin.html.\nexport const PUBLIC_KEY = ${JSON.stringify(pub, null, 2)};\n`;
function renderKeys() {
  const k = rd(KEYS, null);
  $('k-status').className = 'msg ' + (k ? 'ok' : 'err');
  $('k-status').textContent = k ? 'Keys maujood hain. Codes bana sakte hain.' : 'Abhi keys nahi hain. "Generate keys" dabayein.';
  $('k-pub-card').classList.toggle('hide', !k);
  $('k-export').classList.toggle('hide', !k);
  if (k) $('k-pub').value = proKeyFile(k.pub);
}
$('k-gen').onclick = async () => {
  if (rd(KEYS, null) && !confirm('Purani keys hat jayengi aur purane codes kaam karna band kar denge. Pehle Backup le liya hai?')) return;
  wr(KEYS, await genKeys()); renderKeys();
};
$('k-export').onclick = () => dl('shopmaster-admin-keys-BACKUP.json', JSON.stringify(rd(KEYS, null)), 'application/json');
$('k-import-btn').onclick = () => $('k-import').click();
$('k-import').onchange = async e => {
  try {
    const k = JSON.parse(await e.target.files[0].text());
    if (!k.priv || !k.pub) throw 0;
    wr(KEYS, k); renderKeys();
  } catch { alert('Ye sahi backup file nahi hai'); }
  e.target.value = '';
};
$('k-copy').onclick = async () => { await copy($('k-pub').value); $('k-copy').textContent = 'Copied'; setTimeout(() => $('k-copy').textContent = 'Copy', 1500); };
$('k-dl').onclick = () => dl('proKey.js', $('k-pub').value, 'text/javascript');

refreshGen();
</script>
</body>
</html>
